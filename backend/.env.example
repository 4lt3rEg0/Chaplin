# Copy this file to backend/.env and fill in real values. Never commit .env —
# it's already in .gitignore, this file is the template that IS committed.

# Required for a stable beta/production deployment (CHAPLIN_ENV=beta or
# production fails fast at startup without this — a random per-process
# secret would invalidate every user's session on every restart).
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CHAPLIN_SECRET_KEY=replace-me

# development (default) | beta | production
CHAPLIN_ENV=development

# Comma-separated list of allowed frontend origins for CORS. Defaults to "*"
# in development if unset; set explicitly for beta/production.
# CHAPLIN_ALLOWED_ORIGINS=https://chaplin.example.com

# Optional: override the canonical DB/media locations (absolute paths only —
# a relative path here depends on the process's working directory at launch,
# which is exactly the ambiguity that caused the old duplicate-DB confusion).
# CHAPLIN_DB_PATH=C:/absolute/path/to/chaplin.db
# CHAPLIN_MEDIA_ROOT=C:/absolute/path/to/media

# Optional: max upload size in MB (default 50).
# CHAPLIN_MAX_UPLOAD_MB=50
